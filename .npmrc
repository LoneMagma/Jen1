# Arch Linux (and other rolling-release distros) often ship a system-wide
# libvips newer than what sharp's prebuilt binary was compiled against.
# When sharp's installer detects that global libvips, it tries to compile
# sharp from source against it instead of just downloading its own known-
# good prebuilt binary — and that source build is what fails with
# "Please add node-addon-api to your dependencies". This setting tells
# sharp to ignore any global libvips and always use its prebuilt binary.
# https://sharp.pixelplumbing.com/install#custom-libvips
sharp_ignore_global_libvips=true
